{
  "expo": {
    "name": "PsyMap",
    "slug": "psymap",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "psymap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.psymap.app"
    },
    "android": {
      "package": "org.psymap.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
